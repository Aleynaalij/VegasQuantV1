    {
      "path": "supabase/migrations/20261019010000_nba_shadow_scan_dispatch.sql",
      "sql": "-- GitHub ran the NBA shadow scan's 15-minute schedule only 11 times between Oct 17 21:42Z and Oct 19\n-- 05:17Z. A FanDuel props snapshot arrives at most every 30 minutes to 6 hours and the scan only accepts\n-- quotes received within 30 minutes, so the first opening-night props (Oct 19 07:02Z) were never\n-- scanned. Supabase's scheduler now starts the workflow, the same way as the NFL model scan\n-- (20261018030000/20261018050000): every 5 minutes it looks for a FanDuel points or rebounds snapshot\n-- of an upcoming regular-season game newer than the last dispatch and, if one arrived in the last 10\n-- minutes, asks GitHub to run the workflow once for that batch. net.http_post only queues the request,\n-- so the request id is kept and a dispatch GitHub rejected is re-sent, up to three attempts, until the\n-- batch is 15 minutes old. The workflow's own GitHub schedule is removed so one batch starts one run.\n--\n-- Uses the research board's Vault token ('github_research_board_token': this repository only,\n-- Actions read and write). Without it the job does nothing.\ncreate extension if not exists pg_cron;",
      "reason": "Managed extension unavailable; inert local platform stand-in, not a source-function rewrite"
    },
    {
      "path": "supabase/migrations/20261019010000_nba_shadow_scan_dispatch.sql",
      "sql": "\ncreate extension if not exists pg_net;",
      "reason": "Managed extension unavailable; inert local platform stand-in, not a source-function rewrite"
    },
    {
      "path": "supabase/migrations/20261022010000_nba_daily_collection.sql",
      "sql": "-- NBA paused (owner decision, Oct 22 2026): the NBA pages are closed and NBA data is collected once a day,\n-- for the record only, until the season has enough games to reference.\n--  * nba-sync (ESPN schedule, scores and injuries; The Odds API lines and props within 36 hours) runs at\n--    6:00 a.m. Eastern instead of every 15 minutes. Its cadence rules still apply, so each morning reads\n--    today's lines and props once.\n--  * nba-results reads the previous night's box scores at 6:05 a.m. A final box score is recorded only\n--    when the same numbers are read again 3 hours later (20261018070000), so a free ESPN confirming read\n--    runs at 9:10 a.m.; anything still unconfirmed is picked up the next morning.\n--  * The NBA shadow scan stops: its dispatcher is unscheduled (the model stays SHADOW_ONLY, unchanged).\n-- pg_cron runs in UTC, so each job is scheduled at both the EDT and EST hour and runs only when it is that\n-- hour in New York.\ncreate extension if not exists pg_cron;",
      "reason": "Managed extension unavailable; inert local platform stand-in, not a source-function rewrite"
    },
