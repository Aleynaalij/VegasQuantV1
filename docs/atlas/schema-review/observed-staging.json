  "functions": [
    {
      "acl": "{postgres=X/postgres,service_role=X/postgres,authenticated=X/postgres}",
      "owner": "postgres",
      "signature": "age_verification_status()",
      "definition": "CREATE OR REPLACE FUNCTION public.age_verification_status()\n RETURNS jsonb\n LANGUAGE sql\n STABLE\n SET search_path TO ''\nAS $function$\n select jsonb_build_object('required',true,'verified',coalesce((select verified from vq_fixture.age_states where user_id=auth.uid()),false),'state','synthetic_fixture','version',1,'retry_after',null,'synthetic',true)\n$function$\n"
    },
    {
      "acl": "{postgres=X/postgres,service_role=X/postgres,authenticated=X/postgres}",
      "owner": "postgres",
      "signature": "game_zone_posts(text,uuid,integer)",
      "definition": "CREATE OR REPLACE FUNCTION public.game_zone_posts(p_sport text, p_game uuid, p_limit integer DEFAULT 30)\n RETURNS jsonb\n LANGUAGE sql\n STABLE\n SET search_path TO ''\nAS $function$ select coalesce(jsonb_agg(to_jsonb(p)-'game_id'),'[]'::jsonb) from (select * from vq_fixture.posts where sport=p_sport and game_id=p_game order by created_at desc limit greatest(0,least(p_limit,50))) p $function$\n"
    },
    {
      "acl": "{postgres=X/postgres,service_role=X/postgres,anon=X/postgres,authenticated=X/postgres}",
      "owner": "postgres",
      "signature": "membership_status()",
      "definition": "CREATE OR REPLACE FUNCTION public.membership_status()\n RETURNS jsonb\n LANGUAGE plpgsql\n STABLE\n SET search_path TO ''\nAS $function$ begin if auth.uid() is null then return jsonb_build_object('allowed',false); end if; return jsonb_build_object('allowed',vq_fixture.allowed()); end $function$\n"
    },
    {
      "acl": "{postgres=X/postgres,service_role=X/postgres,authenticated=X/postgres}",
      "owner": "postgres",
      "signature": "sports_slate(text,integer)",
      "definition": "CREATE OR REPLACE FUNCTION public.sports_slate(p_sport text, p_days integer DEFAULT 7)\n RETURNS jsonb\n LANGUAGE sql\n STABLE\n SET search_path TO ''\nAS $function$ select jsonb_build_object('version',1,'sport',p_sport,'access',vq_fixture.allowed(),'games',coalesce((select games from vq_fixture.sports where sport=p_sport),'[]'::jsonb),'facts',coalesce((select facts from vq_fixture.sports where sport=p_sport),'[]'::jsonb),'markets',coalesce((select markets from vq_fixture.sports where sport=p_sport),'[]'::jsonb),'selections',coalesce((select selections from vq_fixture.sports where sport=p_sport),'[]'::jsonb)) $function$\n"
    },
    {
      "acl": "{postgres=X/postgres,service_role=X/postgres,anon=X/postgres,authenticated=X/postgres}",
      "owner": "postgres",
      "signature": "tester_feature_access(text)",
      "definition": "CREATE OR REPLACE FUNCTION public.tester_feature_access(p_feature text)\n RETURNS boolean\n LANGUAGE sql\n STABLE\n SET search_path TO ''\nAS $function$ select false $function$\n"
    },
    {
      "acl": "{postgres=X/postgres,service_role=X/postgres,authenticated=X/postgres}",
