{
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": {
      "codex/private-development-transition": false,
      "codex/atlas-combined-stage": false,
      "codex/atlas-isolated-db-prep": false,
      "codex/atlas-final-integration": false,
      "elo/atlas-consumer-reader-ci": false,
      "codex/atlas-authenticated-experience": false,
      "codex/atlas-feature-preservation": false,
      "codex/atlas-consumer-contracts": false,
      "codex/atlas-production-owner-preview": false
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/account/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
